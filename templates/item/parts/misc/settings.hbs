<div class="field-list">
    {{> (template "fields/boolean") label="Equipped" edit="system.equipped"}}
    {{> (template "fields/number") label="Cost" edit="system.cost"}}
    {{> (template "fields/number") label="Weight" edit="system.weight"}}
    {{> (template "fields/string") label="Source" edit="system.source"}}

    {{!-- Services (Shopping #15): override how this item is treated when shopping is enabled. "Auto"
         infers from the source list / name; the others force gear / a recurring bill / a one-off. --}}
    <div class="field">
        <label for="system.serviceMode">{{CPLocal "ServiceMode"}}</label>
        <span class="flex-pad"></span>
        <select name="system.serviceMode">
            <option value="" {{#if (equals system.serviceMode "")}}selected{{/if}}>{{CPLocal "ServiceModeAuto"}}</option>
            <option value="gear" {{#if (equals system.serviceMode "gear")}}selected{{/if}}>{{CPLocal "ServiceModeGear"}}</option>
            <option value="recurring" {{#if (equals system.serviceMode "recurring")}}selected{{/if}}>{{CPLocal "ServiceModeRecurring"}}</option>
            <option value="oneoff" {{#if (equals system.serviceMode "oneoff")}}selected{{/if}}>{{CPLocal "ServiceModeOneoff"}}</option>
        </select>
    </div>
    {{#if (equals system.serviceMode "recurring")}}
    <div class="field">
        <label for="system.servicePeriod">{{CPLocal "ServicePeriod"}}</label>
        <span class="flex-pad"></span>
        <input class="textsize" name="system.servicePeriod" type="text" value="{{system.servicePeriod}}"/>
    </div>
    {{/if}}

    {{!-- Ammo Locker: optional feature (GM setting, off by default). Turns this item into an
         in-inventory ammunition-buying interface. --}}
    {{#if ammoLockerFeature}}
    <div class="field full-width">
        <label>{{CPLocal "AmmoLockerToggle"}}</label>
        <span class="flex-pad"></span>
        <input type="checkbox" class="cp-locker-toggle" {{#if isAmmoLocker}}checked{{/if}}>
    </div>
    {{#if isAmmoLocker}}
    <div class="field full-width">
        <span class="flex-pad"></span>
        <button type="button" class="cp-locker-buy" title="{{CPLocal "AmmoLockerHint"}}">{{CPLocal "AmmoBuyTitle"}}</button>
    </div>
    {{/if}}
    {{/if}}
</div>